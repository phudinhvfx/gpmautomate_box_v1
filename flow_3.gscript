                                "delay": "0,0",
                                "continue_on_error": false,
                                "id": "4c15b7af-8ad7-4c06-9717-bc2732e6a1e5",
                                "display_text": "Set variable",
                                "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"$readScrollStartX,$readScrollStartY\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
                                "comment": "set comment read start point"
                              },
                              {
                                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                "type": 1,
                                "element_xpath": null,
                                "output_variable_name": "readScrollEndPos",
                                "delay": "0,0",
                                "continue_on_error": false,
                                "id": "56f00cb2-8423-4100-a06c-5e8db0e1a969",
                                "display_text": "Set variable",
                                "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"$readScrollEndX,$readScrollEndY\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
                                "comment": "set comment read end point"
                              },
                              {
                                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                "type": 108,
                                "element_xpath": null,
                                "output_variable_name": null,
                                "delay": "400,700",
                                "continue_on_error": false,
                                "id": "f6c3dd4d-a615-4ca5-a83a-1432c2f3adc6",
                                "display_text": "Scroll",
                                "raw_input": "[{\"Key\":\"SCROLL_TYPE\",\"Value\":\"POINTS\"},{\"Key\":\"DIRECTION\",\"Value\":\"Up\"},{\"Key\":\"START_POS\",\"Value\":\"$readScrollStartPos\"},{\"Key\":\"END_POS\",\"Value\":\"$readScrollEndPos\"},{\"Key\":\"DURATION_MS\",\"Value\":\"$readScrollDuration\"},{\"Key\":\"POS\",\"Value\":\"\"},{\"Key\":\"ACTION_TYPE\",\"Value\":\"Down\"}]",
                                "comment": "scroll comments up a small distance"
                              }
                            ],
                            "expanded": true,
                            "continue_on_error": false,
                            "id": "1e939ed8-654e-4298-8fc6-0ba47f4e97f7",
                            "display_text": "Normal block",
                            "raw_input": null,
                            "comment": "random small scroll inside comment panel"
                          }
                        ],
                        "expanded": true,
                        "continue_on_error": false,
                        "id": "a9d37fb4-89cc-4cce-b97b-ba4788122cf4",
                        "display_text": "For",
                        "raw_input": "[{\"Key\":\"START\",\"Value\":\"0\"},{\"Key\":\"END\",\"Value\":\"$readScrollTimes\"},{\"Key\":\"STEP\",\"Value\":\"1\"}]",
                        "comment": "read comments with two small upward scrolls"
                      }
                    ],
                    "expanded": true,
                    "continue_on_error": false,
                    "id": "1ad9d9e8-e616-46cb-9c2c-6b119956dc9a",
                    "display_text": "Normal block",
                    "raw_input": null,
                    "comment": "read comments"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.NormalBlockNode, GPMAutomateEditor.Models",
                    "nodes": [
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                        "type": 108,
                        "element_xpath": null,
                        "output_variable_name": null,
                        "delay": "0,0",
                        "continue_on_error": false,
                        "id": "429106a5-a7f6-4d07-af8c-d0b8a3a51962",
                        "display_text": "Scroll",
                        "raw_input": "[{\"Key\":\"SCROLL_TYPE\",\"Value\":\"POINTS\"},{\"Key\":\"DIRECTION\",\"Value\":\"Up\"},{\"Key\":\"START_POS\",\"Value\":\"720,450\"},{\"Key\":\"END_POS\",\"Value\":\"720,1750\"},{\"Key\":\"DURATION_MS\",\"Value\":\"650\"},{\"Key\":\"POS\",\"Value\":\"\"},{\"Key\":\"ACTION_TYPE\",\"Value\":\"Down\"}]",
                        "comment": "swipe down to close comment panel"
                      },
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                        "type": 7,
                        "element_xpath": null,
                        "output_variable_name": null,
                        "delay": "0,0",
                        "continue_on_error": false,
                        "id": "436451c1-bb39-4996-88d5-91ad5c03f6d5",
                        "display_text": "Delay",
                        "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"600\"},{\"Key\":\"MAX\",\"Value\":\"800\"}]",
                        "comment": "wait comment panel close"
                      },
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                        "type": 32,
                        "element_xpath": null,
                        "output_variable_name": "commentPanelImageAfterClose",
                        "delay": "0,0",
                        "continue_on_error": false,
                        "id": "75854202-0a66-42f0-b1f0-66bd9d18f5dc",
                        "display_text": "Image exists",
                        "raw_input": "[{\"Key\":\"IMG\",\"Value\":\"img_6.img64\"},{\"Key\":\"THRESH_HOLD\",\"Value\":\"0.8\"},{\"Key\":\"TRUE_COLOR\",\"Value\":\"No\"}]",
                        "comment": "verify comment panel image after close"
                      },
                      {
                        "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                        "condition": "$commentPanelImageAfterClose = \"false\"",
                        "nodes": [
                          {
                            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                            "type": 1,
                            "element_xpath": null,
                            "output_variable_name": "flow3Result",
                            "delay": "0,0",
                            "continue_on_error": false,
                            "id": "495cb25a-da11-48a7-ab60-0e014addd797",
                            "display_text": "Set variable",
                            "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"COMMENT_PANEL_CLOSED\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
                            "comment": "log comment panel closed"
                          }
                        ],
                        "expanded": true,
                        "continue_on_error": false,
                        "id": "07cb6979-28a2-4a1c-9d8f-ee6b076acdc2",
                        "display_text": "If",
                        "raw_input": "[{\"Key\":\"CONDITION\",\"Value\":\"$commentPanelImageAfterClose = \\\"false\\\"\"}]",
                        "comment": "comment panel image is gone"
                      },
                      {
                        "$type": "GPMAutomateEditor.Models.ElseBlockNode, GPMAutomateEditor.Models",
