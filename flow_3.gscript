                                "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"1400\"},{\"Key\":\"MAX\",\"Value\":\"1650\"}]",
                                "comment": "random comment read end y"
                              },
                              {
                                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                "type": 11,
                                "element_xpath": null,
                                "output_variable_name": "readScrollDuration",
                                "delay": "0,0",
                                "continue_on_error": false,
                                "id": "0d71b284-4376-40d5-9ff9-011420c07a79",
                                "display_text": "Random number",
                                "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"350\"},{\"Key\":\"MAX\",\"Value\":\"550\"}]",
                                "comment": "random small comment scroll duration"
                              },
                              {
