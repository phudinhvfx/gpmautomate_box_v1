                                "display_text": "Random number",
                                "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"1750\"},{\"Key\":\"MAX\",\"Value\":\"2050\"}]",
                                "comment": "random comment read start y"
                              },
                              {
                                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                "type": 11,
                                "element_xpath": null,
                                "output_variable_name": "readScrollEndX",
                                "delay": "0,0",
                                "continue_on_error": false,
