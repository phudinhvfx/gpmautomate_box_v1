                "continue_on_error": false,
                "id": "b2360e30-8076-48a0-995c-5c87a829f3d9",
                "display_text": "Set variable",
                "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"HOME_ICON_FOUND\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
